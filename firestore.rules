rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner of the document
    function isOwner(email) {
      return isAuthenticated() && request.auth.token.email == email;
    }
    
    // Helper function to validate user data structure
    function isValidUserData() {
      let requiredFields = ['name', 'email', 'id', 'profileImg', 'quizGiven', 
                           'winningStreak', 'level', 'gameWin', 'totalScore', 
                           'highestScore', 'correctAnswers', 'badges', 'notifications'];
      return request.resource.data.keys().hasAll(requiredFields);
    }
    
    // Helper function to ensure email field cannot be changed
    function emailNotChanged() {
      return !('email' in request.resource.data) || 
             request.resource.data.email == resource.data.email;
    }
    
    // Users collection rules
    match /users/{userEmail} {
      // Allow public read access for leaderboard and dashboard
      allow read: if true;
      
      // Allow authenticated users to create their own document
      allow create: if isOwner(userEmail) && isValidUserData();
      
      // Allow users to update only their own profile
      // Ensure email cannot be changed after creation
      allow update: if isOwner(userEmail) && emailNotChanged();
      
      // Allow users to delete only their own account
      allow delete: if isOwner(userEmail);
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
